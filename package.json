{
  "name": "auto-config-js",
  "version": "0.0.0",
  "description": "Hierarchical NodeJS configuration with Yaml files, environment variables and config merging.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "repository": "otaciliolacerda/auto-config-js",
  "homepage": "https://github.com/otaciliolacerda/auto-config-js#readme",
  "keywords": [
    "configuration",
    "environment",
    "config",
    "yaml",
    "auto-configuration"
  ],
  "author": "otaciliolacerda",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/otaciliolacerda/auto-config-js/issues"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.6.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-plugin-sonarjs": "^4.0.3",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "pinst": "^3.0.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "js-yaml": "^4.1.1"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint --fix './lib/**/*.ts' './test/**/*.ts'",
    "prettier": "prettier 'lib/**/*' 'test/**/*'",
    "prettier:fix": "prettier --write 'lib/**/*' 'test/**/*'",
    "release": "npm publish",
    "prepare": "husky",
    "prepublishOnly": "npm run build && pinst --disable",
    "postpublish": "pinst --enable"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
