{
  "name": "auto-config-js",
  "version": "0.0.0",
  "description": "Hierarchical NodeJS configuration with Yaml files, environment variables and config merging.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "repository": "otaciliolacerda/auto-config-js",
  "homepage": "https://github.com/otaciliolacerda/auto-config-js#readme",
  "keywords": [
    "configuration",
    "environment",
    "config",
    "yaml",
    "auto-configuration"
  ],
  "author": "otaciliolacerda",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/otaciliolacerda/auto-config-js/issues"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "js-yaml": "^5.2.2"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json && tsc --project tsconfig.build.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type:'commonjs'},null,2))\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format:check": "biome format .",
    "format:fix": "biome format --write .",
    "release": "npm publish",
    "prepare": "git config core.hooksPath .githooks || true",
    "prepublishOnly": "npm run build"
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
